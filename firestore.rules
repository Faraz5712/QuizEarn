rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update, delete: if false;

      match /taskProgress/{progressId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /quizDays/{dateId} {
        allow read, write: if false;
      }

      match /taskClaims/{claimId} {
        allow read, write: if false;
      }

      match /tournamentRegistrationKeys/{keyId} {
        allow read, write: if false;
      }

      match /tournamentResultKeys/{keyId} {
        allow read, write: if false;
      }

      match /tournamentResultUses/{sessionId} {
        allow read, write: if false;
      }

      match /walletTransactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /redemptions/{redemptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /quizResults/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /rewards/{rewardId} {
      allow read: if signedIn() && resource.data.active == true;
      allow write: if false;
    }

    match /quizSessions/{sessionId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read: if signedIn() && resource.data.isActive == true;
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read, write: if false;
    }

    match /tournaments/{tournamentId} {
      allow read, write: if false;

      match /participants/{userId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /tournamentFinalizations/{tournamentId} {
      allow read, write: if false;
    }

    match /questionBank/{questionId} {
      allow read: if false;
      allow write: if false;
    }

    match /walletIdempotency/{documentId} {
      allow read, write: if false;
    }

    match /redemptionIdempotency/{documentId} {
      allow read, write: if false;
    }

    match /quizIdempotency/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
